{
  "expo": {
    "name": "Polarys",
    "slug": "polarys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polarys",
    "userInterfaceStyle": "dark",
    "jsEngine": "jsc",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.polarys.app",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Polarys checks your location near bars at night so it can offer you a safe ride home before you drive.",
        "NSLocationWhenInUseUsageDescription": "Polarys uses your location to find safe rides and nearby help.",
        "NSLocationAlwaysUsageDescription": "Polarys checks your location near bars at night so it can offer you a safe ride home before you drive.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "uber",
          "lyft"
        ]
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C100D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.polarys.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Polarys uses your location to find safe rides and nearby help.",
          "locationAlwaysAndWhenInUsePermission": "Polarys checks your location near bars at night so it can offer you a safe ride home before you drive.",
          "locationAlwaysPermission": "Polarys checks your location near bars at night so it can offer you a safe ride home before you drive.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C100D",
          "dark": {
            "backgroundColor": "#1C100D"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bd9eacd-959d-4742-9d8e-118c8c1e1a70"
      }
    }
  }
}
